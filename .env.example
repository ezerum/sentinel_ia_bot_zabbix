# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_CHAT_IDS=IDS_CHAT

# Zabbix
ZABBIX_URL=http://IP-SERVER/zabbix
ZABBIX_API_TOKEN=YOUR_ZABBIX_API_TOKEN

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# LLM (opcional por ahora)
LLM_ENABLED=0
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=YOUR_OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=25
LLM_MAX_OUTPUT_TOKENS=350
LLM_MAX_CHARS=4500

# Cost controls
LLM_CACHE_TTL_S=900
LLM_RATE_LIMIT_PER_MIN=6

# Orchestrator
OPS_API_URL=http://sentinel-ops:9000
OPS_API_KEY=YOUR_OPS_API_KEY
OPS_ALLOWED_ACTIONS=restart_host

# Restart policy
OPS_REQUIRE_ACTIVE_PROBLEM=1
OPS_MIN_SEVERITY=3
OPS_PROBLEM_LOOKBACK_MIN=60

# Zabbix (para que el Orchestrator valide contra Zabbix)
OPS_ZABBIX_URL=http://IP-SERVER/zabbix
OPS_ZABBIX_API_TOKEN=YOUR_ZABBIX_API_TOKEN

# Bot admins (quién puede pedir acciones)
OPS_CONFIRM_TTL_S=60
OPS_ADMIN_TELEGRAM_IDS=IDS_ADMIN_TELEGRAM
OPS_REQUIRE_CONFIRM=1